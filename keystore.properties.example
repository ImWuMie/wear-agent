# Release signing for WearAgent. NOT committed (see .gitignore).
# Generate your own with:
#   keytool -genkeypair -v -keystore keystore/wearagent.jks -alias wearagent \
#     -keyalg RSA -keysize 4096 -validity 10950
storeFile=keystore/wearagent.jks
storePassword=REPLACE_ME
keyAlias=wearagent
keyPassword=REPLACE_ME
